# GEMINI_API_KEY: Optional for future AI-powered summaries
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Local development server port (default 3000)
PORT=3000

# SUPABASE_URL: Optional Supabase project endpoint if connecting external Supabase instance
# SUPABASE_ANON_KEY: Optional public anon key
# SUPABASE_SERVICE_ROLE_KEY: Optional service role key (backend only, never exposed to browser)
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

